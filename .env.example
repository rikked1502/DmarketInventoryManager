# Copy this file to .env and paste your keys from dmarket.com -> Settings -> Trading API.
# .env is git-ignored. Never commit or share your secret key.

# Default account (shown as "Main")
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=

# More accounts: add a pair with the same suffix. The suffix becomes the name in the account switcher.
# DMARKET_PUBLIC_KEY_ALT=
# DMARKET_SECRET_KEY_ALT=
